#!/bin/sh

set -eu

expected_name="econ-space"
expected_email="215001386+econ-space@users.noreply.github.com"
expected_remote="git@github-econ-space:econ-space/econ-space.github.io.git"

actual_name=$(git config --get user.name || true)
actual_email=$(git config --get user.email || true)
actual_remote=$(git config --get remote.origin.url || true)

if [ "$actual_name" != "$expected_name" ]; then
  printf '%s\n' "Commit blocked: user.name must be '$expected_name', not '$actual_name'." >&2
  exit 1
fi

if [ "$actual_email" != "$expected_email" ]; then
  printf '%s\n' "Commit blocked: user.email must be '$expected_email', not '$actual_email'." >&2
  exit 1
fi

if [ "$actual_remote" != "$expected_remote" ]; then
  printf '%s\n' "Commit blocked: origin must be '$expected_remote', not '$actual_remote'." >&2
  exit 1
fi
